#!/bin/bash

set -euo pipefail

ROOT="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

for tz in UTC America/Chicago America/New_York Pacific/Honolulu Europe/London Asia/Tokyo Pacific/Auckland Pacific/Kiritimati; do
  TZ="$tz" node "$ROOT/test/model-test.js"
done
bash "$ROOT/test/helper-test.sh"
python3 "$ROOT/test/permissions-test.py"
python3 "$ROOT/test/caldav-limit-test.py"
bash "$ROOT/test/qml-test.sh"
python3 "$ROOT/test/caldav-harness.py"
python3 "$ROOT/test/webcal-harness.py"
bash "$ROOT/test/write-test.sh"

echo "ok - all tests"
