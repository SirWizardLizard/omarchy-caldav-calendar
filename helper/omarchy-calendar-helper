            "calendarId": "personal",
            "calendarName": "Personal",
            "calendarColor": "#8aadf4",
            "title": "Calendar sync check",
            "location": "Omarchy",
            "description": "Mock event used while developing the provider-neutral UI.",
            "start": iso(first),
            "end": iso(first + timedelta(hours=1)),
            "allDay": False,
            "status": "confirmed",
            "provider": "mock",
            "source": "Mock Calendar",
        },
