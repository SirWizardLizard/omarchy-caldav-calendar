@dataclass
class EdsModules:
    EDataServer: object
    ECal: object
    ICalGLib: object
    GLib: object | None = None


def load_eds_modules() -> EdsModules:
    try:
        import gi  # type: ignore
    except Exception as error:  # pragma: no cover - depends on host packages
        raise RuntimeError("Python GI bindings are not available.") from error

    try:
        gi.require_version("EDataServer", "1.2")
        gi.require_version("ECal", "2.0")
        gi.require_version("ICalGLib", "4.0")
        from gi.repository import ECal, EDataServer, GLib, ICalGLib  # type: ignore
    except Exception as error:  # pragma: no cover - depends on host packages
        raise RuntimeError("Evolution Data Server is not installed.") from error

    modules = EdsModules(EDataServer=EDataServer, ECal=ECal, ICalGLib=ICalGLib)
    modules.GLib = GLib
    return modules


def eds_status() -> dict:
    try:
        load_eds_modules()
        return {"ok": True, "provider": "evolution-data-server", "status": "present"}
    except Exception as error:  # pragma: no cover - depends on host packages
        return {
            "ok": False,
            "provider": "evolution-data-server",
            "status": "missing",
            "error": {
                "code": "eds-bindings-missing",
                "message": "Evolution Data Server is not installed. It is required to store calendar data locally.",
                "detail": str(error),
            },
        }


def source_provider(source, registry, modules: EdsModules) -> str:
    eds = modules.EDataServer
    if source.has_extension(eds.SOURCE_EXTENSION_GOA):
        return "gnome-online-accounts"
    if source.has_extension(eds.SOURCE_EXTENSION_WEBDAV_BACKEND):
        return "caldav"
    if source.has_extension(eds.SOURCE_EXTENSION_LOCAL_BACKEND):
        return "local"

    parent_id = source.get_parent()
    if parent_id:
        parent = registry.ref_source(parent_id)
        if parent:
            if parent.has_extension(eds.SOURCE_EXTENSION_GOA):
                return "gnome-online-accounts"
            if parent.has_extension(eds.SOURCE_EXTENSION_WEBDAV_BACKEND):
                return "caldav"
            if parent.has_extension(eds.SOURCE_EXTENSION_LOCAL_BACKEND):
                return "local"

    return "evolution-data-server"


def source_host(source, modules: EdsModules) -> str:
    eds = modules.EDataServer
    if not source.has_extension(eds.SOURCE_EXTENSION_WEBDAV_BACKEND):
        return ""
    uri = source.get_extension(eds.SOURCE_EXTENSION_WEBDAV_BACKEND).dup_uri()
    if uri is None:
        return ""
    return str(uri.get_host() or "")


def source_webdav_url(source, modules: EdsModules) -> str:
    eds = modules.EDataServer
    if not source.has_extension(eds.SOURCE_EXTENSION_WEBDAV_BACKEND):
        return ""
    uri = source.get_extension(eds.SOURCE_EXTENSION_WEBDAV_BACKEND).dup_uri()
    if uri is None:
        return ""
    scheme = uri.get_scheme() or "https"
    host = uri.get_host() or ""
    path = uri.get_path() or "/"
    port = int(uri.get_port() or 0)
    if not host:
        return ""
    default_port = 443 if scheme == "https" else 80
    if port > 0 and port != default_port:
        return f"{scheme}://{host}:{port}{path}"
    return f"{scheme}://{host}{path}"


def source_calendar(source, registry, modules: EdsModules) -> dict:
    color = ""
    if source.has_extension(modules.EDataServer.SOURCE_EXTENSION_CALENDAR):
        extension = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_CALENDAR)
        color = extension.get_color() if extension and hasattr(extension, "get_color") else ""
    return {
        "id": source.get_uid(),
        "name": source.get_display_name(),
        "color": color or "",
        "provider": source_provider(source, registry, modules),
        "host": source_host(source, modules),
        "source": "Evolution Data Server",
        "readonly": None,
    }


def text_value(value) -> str:
    if value is None:
        return ""
    if hasattr(value, "get_value"):
        return str(value.get_value() or "")
    return str(value or "")


def resolve_ical_timezone(modules: EdsModules, tzid: str, client=None):
    name = str(tzid or "").strip()
    if not name:
        return None
    timezone = modules.ICalGLib.Timezone.get_builtin_timezone(name)
    if timezone is not None:
        return timezone
    timezone = modules.ICalGLib.Timezone.get_builtin_timezone_from_tzid(name)
    if timezone is not None:
        return timezone
    if client is not None and hasattr(client, "get_timezone_sync"):
        try:
            ok, timezone = client.get_timezone_sync(name, None)
            if ok:
                return timezone
        except Exception:
            return None
    return None


def ical_value_to_iso(value, tzid: str, modules: EdsModules | None = None, client=None) -> tuple[str, bool]:
    if value is None or (hasattr(value, "is_null_time") and value.is_null_time()):
        return "", False
    if hasattr(value, "is_date") and value.is_date():
        return f"{value.get_year():04d}-{value.get_month():02d}-{value.get_day():02d}", True
    zone_name = str(tzid or (value.get_tzid() if hasattr(value, "get_tzid") else "") or "")
    if hasattr(value, "is_utc") and value.is_utc():
        return iso(datetime.fromtimestamp(value.as_timet(), UTC)), False
    zone = resolve_ical_timezone(modules, zone_name, client) if modules is not None else None
    if zone is not None and hasattr(value, "as_timet_with_zone"):
        return iso(datetime.fromtimestamp(value.as_timet_with_zone(zone), UTC)), False
    if zone_name:
        local = datetime(value.get_year(), value.get_month(), value.get_day(), value.get_hour(), value.get_minute(), value.get_second())
        return iso(local.astimezone().astimezone(UTC)), False
    return iso(datetime.fromtimestamp(value.as_timet(), UTC)), False


def component_datetime(component_dt, modules: EdsModules | None = None, client=None) -> tuple[str, bool, str]:
    if component_dt is None:
        return "", False, ""
    value = component_dt.get_value()
    tzid = component_dt.get_tzid() or (value.get_tzid() if value is not None and hasattr(value, "get_tzid") else "") or ""
    if value is None or value.is_null_time():
        return "", False, tzid
    stamp, all_day = ical_value_to_iso(value, tzid, modules, client)
    return stamp, all_day, tzid


def ical_time_iso(value, modules: EdsModules | None = None, client=None) -> tuple[str, bool]:
    tzid = value.get_tzid() if value is not None and hasattr(value, "get_tzid") else ""
    return ical_value_to_iso(value, tzid, modules, client)


def append_component_events(client, component, calendar: dict, window_start: datetime, window_end: datetime, events: list, modules: EdsModules | None = None) -> None:
    base = component_event(component, calendar, modules, client)
    if not base["id"] or not base["start"]:
        return
    if not hasattr(component, "has_recurrences") or not component.has_recurrences():
        events.append(base)
        return
    ical = component.get_icalcomponent() if hasattr(component, "get_icalcomponent") else None
    if ical is None:
        events.append(base)
        return
    collected = []

    def cb(_icomp, instance_start, instance_end, _user_data, _cancellable=None):
        if len(events) + len(collected) >= MAX_EVENTS:
            return False
        start, all_day = ical_time_iso(instance_start, modules, client)
        end, end_all_day = ical_time_iso(instance_end, modules, client)
        if not start:
            return True
        event = dict(base)
        event["start"] = start
        event["end"] = end or start
        event["allDay"] = bool(event["allDay"] or all_day or end_all_day)
        event["rid"] = iso_to_rid(start, event["allDay"])
        event["recurring"] = True
        event["id"] = ":".join(part for part in [event["calendarId"], event["uid"], event["rid"] or start] if part)
        collected.append(event)
        return True

    try:
        client.generate_instances_for_object_sync(
            ical,
            int(window_start.timestamp()),
            int(window_end.timestamp()),
            None,
            cb,
            None,
        )
    except Exception:
        events.append(base)
        return
    events.extend(collected)


def normalize_meeting_url(text: str) -> str:
    raw = str(text or "").strip()
    if not raw:
        return ""
    return raw if re.match(r"https?://", raw, re.I) else "https://" + raw.lstrip("/")


def meeting_from_text(text: str) -> tuple[str, str]:
    blob = str(text or "")
    patterns = (
        ("zoom", r"(?:https?://)?(?:[\w.-]+\.)?zoom\.us/[^\s<>\"']+"),
        ("meet", r"(?:https?://)?meet\.google\.com/[^\s<>\"']+"),
        ("teams", r"(?:https?://)?teams\.(?:microsoft|live)\.com/[^\s<>\"']+"),
    )
    for provider, pattern in patterns:
        found = re.search(pattern, blob, re.I)
        if found:
            return normalize_meeting_url(found.group(0).rstrip(".,);")), provider
    return "", ""


def component_event(component, calendar: dict, modules: EdsModules | None = None, client=None) -> dict:
    uid = component.get_uid() or ""
    rid = component.get_recurid_as_string() or ""
    start, all_day, timezone = component_datetime(component.get_dtstart(), modules, client)
    end, end_all_day, end_timezone = component_datetime(component.get_dtend(), modules, client)
    descriptions = component.get_descriptions() or []
    description = text_value(descriptions[0]) if descriptions else ""
    status = str(component.get_status() or "").lower()
    ical = component.get_icalcomponent() if hasattr(component, "get_icalcomponent") else None
    conference = ical.as_ical_string() if ical is not None and hasattr(ical, "as_ical_string") else ""
    meeting_url, meeting_provider = meeting_from_text("\n".join([component.get_location() or "", description, conference]))
    return {
        "id": ":".join(part for part in [calendar["id"], uid, rid] if part),
        "uid": uid,
        "rid": rid,
        "calendarId": calendar["id"],
        "calendarName": calendar["name"],
        "calendarColor": calendar["color"],
        "title": text_value(component.get_summary()) or "(No title)",
        "location": component.get_location() or "",
        "description": description,
        "start": start,
        "end": end or start,
        "allDay": all_day or end_all_day,
        "timezone": timezone or end_timezone,
        "status": status,
        "meetingUrl": meeting_url,
        "meetingProvider": meeting_provider,
        "recurring": bool(hasattr(component, "has_recurrences") and component.has_recurrences()),
        "provider": calendar["provider"],
        "source": calendar["source"],
    }


def webdav_resource_path(source, modules: EdsModules) -> str:
    eds = modules.EDataServer
    if not source.has_extension(eds.SOURCE_EXTENSION_WEBDAV_BACKEND):
        return "/"
    uri = source.get_extension(eds.SOURCE_EXTENSION_WEBDAV_BACKEND).dup_uri()
    if uri is None:
        return "/"
    return uri.get_path() or "/"


def is_unresolved_caldav_root(source, registry, modules: EdsModules) -> bool:
    if source_provider(source, registry, modules) != "caldav":
        return False
    path = webdav_resource_path(source, modules).rstrip("/") or "/"
    return path == "/"


def is_omarchy_source_uid(uid: str) -> bool:
    return str(uid or "").startswith("omarchy-calendar-")


def commit_new_source(registry, source):
    uid = source.get_uid() if source is not None and hasattr(source, "get_uid") else ""
    if not is_omarchy_source_uid(uid):
        return None
    if not registry.commit_source_sync(source, None):
        return None
    return registry.ref_source(uid) or source


def discard_committed_source(registry, uid: str) -> None:
    uid = str(uid or "").strip()
    if not is_omarchy_source_uid(uid):
        return
    try:
        source = registry.ref_source(uid)
        if source is None:
            return
        try:
            source.remove_sync(None)
        except Exception:
            source.set_enabled(False)
            registry.commit_source_sync(source, None)
    except Exception:
        return


def is_omarchy_collection_child(source) -> bool:
    uid = source.get_uid() if hasattr(source, "get_uid") else ""
    if is_omarchy_source_uid(uid):
        return False
    parent = source.get_parent() if hasattr(source, "get_parent") else ""
    return is_omarchy_source_uid(str(parent or ""))


def caldav_source_key(source, modules: EdsModules) -> tuple[str, str] | None:
    host = source_host(source, modules).lower().rstrip(".")
    path = webdav_resource_path(source, modules).rstrip("/") or "/"
    if not host or path == "/":
        return None
    return (host, path)


def quiet_omarchy_collection(source, registry, modules: EdsModules) -> None:
    if not is_omarchy_source_uid(source.get_uid()):
        return
    source = registry.ref_source(source.get_uid()) or source
    if not source.has_extension(modules.EDataServer.SOURCE_EXTENSION_COLLECTION):
        return
    collection = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_COLLECTION)
    if not collection.get_calendar_enabled():
        return
    collection.set_calendar_enabled(False)
    registry.commit_source_sync(source, None)


def eds_prune_duplicate_caldav(registry, modules: EdsModules) -> None:
    for source in list(registry.list_sources(modules.EDataServer.SOURCE_EXTENSION_CALENDAR)):
        if not is_omarchy_collection_child(source):
            continue
        try:
            source.remove_sync(None)
        except Exception:
            source.set_enabled(False)
            registry.commit_source_sync(source, None)
    for source in registry.list_sources(modules.EDataServer.SOURCE_EXTENSION_COLLECTION):
        quiet_omarchy_collection(source, registry, modules)


def eds_range_query(start: datetime, end: datetime) -> str:
    def stamp(value: datetime) -> str:
        return value.astimezone(UTC).strftime("%Y%m%dT%H%M%SZ")

    return f'(occur-in-time-range? (make-time "{stamp(start)}") (make-time "{stamp(end)}"))'


def ics_escape(value: str) -> str:
    return str(value or "").replace("\\", "\\\\").replace(";", "\\;").replace(",", "\\,").replace("\n", "\\n")


def ics_datetime(value: datetime, all_day: bool) -> str:
    if all_day:
        return value.astimezone(UTC).strftime("%Y%m%d")
    return value.astimezone(UTC).strftime("%Y%m%dT%H%M%SZ")


def source_for_calendar(registry, calendar_id: str, modules: EdsModules):
    if calendar_id:
        source = registry.ref_source(calendar_id)
        if source and source.has_extension(modules.EDataServer.SOURCE_EXTENSION_CALENDAR):
            return source
        raise ValueError(f"Calendar not found: {calendar_id}")

    for source in registry.list_sources(modules.EDataServer.SOURCE_EXTENSION_CALENDAR):
        if registry.check_enabled(source):
            extension = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_CALENDAR)
            if extension and hasattr(extension, "get_selected") and extension.get_selected():
                return source

    for source in registry.list_sources(modules.EDataServer.SOURCE_EXTENSION_CALENDAR):
        if registry.check_enabled(source):
            return source

    raise ValueError("No enabled calendars found.")


def eds_client_for_calendar(calendar_id: str):
    modules = load_eds_modules()
    registry = modules.EDataServer.SourceRegistry.new_sync(None)
    source = source_for_calendar(registry, calendar_id, modules)
    client = modules.ECal.Client.connect_sync(source, modules.ECal.ClientSourceType.EVENTS, 8, None)
    return modules, registry, source, client


def rrule_for_repeat(repeat: str) -> str:
    mapping = {
        "daily": "FREQ=DAILY",
        "weekday": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR",
        "weekdays": "FREQ=WEEKLY;BYDAY=MO,TU,WE,TH,FR",
        "weekly": "FREQ=WEEKLY",
        "monthly": "FREQ=MONTHLY",
        "yearly": "FREQ=YEARLY",
    }
    return mapping.get(str(repeat or "").strip().lower(), "")


def normalize_rrule(value: str) -> str:
    text = str(value or "").strip()
    if text.upper().startswith("RRULE:"):
        text = text[6:].strip()
    mapped = rrule_for_repeat(text)
    if mapped:
        return mapped
    if not text or text.lower() in ("never", "none"):
        return ""
    parts = {}
    for item in text.split(";"):
        if "=" not in item:
            continue
        key, raw = item.split("=", 1)
        parts[key.strip().upper()] = raw.strip()
    freq = parts.get("FREQ", "").upper()
    if freq not in ("DAILY", "WEEKLY", "MONTHLY", "YEARLY"):
        return ""
    ordered = [f"FREQ={freq}"]
    if parts.get("INTERVAL") and parts["INTERVAL"] != "1":
        ordered.append(f"INTERVAL={parts['INTERVAL']}")
    for key in ("BYMONTH", "BYMONTHDAY", "BYDAY", "BYSETPOS", "COUNT", "UNTIL"):
        if key in parts:
            ordered.append(f"{key}={parts[key].upper() if key == 'BYDAY' else parts[key]}")
    return ";".join(ordered)


def event_component_from_fields(modules: EdsModules, uid: str, title: str, start: datetime, end: datetime, all_day: bool, location: str, description: str, rrule: str = ""):
    now = datetime.now(UTC)
    lines = [
        "BEGIN:VEVENT",
        f"UID:{uid}",
        f"DTSTAMP:{ics_datetime(now, False)}",
        f"CREATED:{ics_datetime(now, False)}",
        f"LAST-MODIFIED:{ics_datetime(now, False)}",
        f"SUMMARY:{ics_escape(title or '(No title)')}",
    ]
    if all_day:
        lines.append(f"DTSTART;VALUE=DATE:{ics_datetime(start, True)}")
        lines.append(f"DTEND;VALUE=DATE:{ics_datetime(end, True)}")
    else:
        lines.append(f"DTSTART:{ics_datetime(start, False)}")
        lines.append(f"DTEND:{ics_datetime(end, False)}")
    if location:
        lines.append(f"LOCATION:{ics_escape(location)}")
    if description:
        lines.append(f"DESCRIPTION:{ics_escape(description)}")
    if rrule:
        lines.append(f"RRULE:{rrule}")
    lines.append("END:VEVENT")
    ical = modules.ICalGLib.Component.new_from_string("\r\n".join(lines) + "\r\n")
    if not ical:
        raise ValueError("Failed to build iCalendar event.")
    return ical


def eds_create_event(calendar_id: str, title: str, start: datetime, end: datetime, all_day: bool, location: str, description: str, rrule: str = "") -> dict:
    modules, registry, source, client = eds_client_for_calendar(calendar_id)
    if client.is_readonly():
        raise ValueError(f"Calendar is read-only: {source.get_display_name()}")

    uid = f"omarchy-calendar-{uuid4()}"
    ical = event_component_from_fields(modules, uid, title, start, end, all_day, location, description, rrule)
    ok, created_uid = client.create_object_sync(ical, modules.ECal.OperationFlags.DISABLE_ITIP_MESSAGE, None)
    if not ok:
        raise ValueError("EDS create_object_sync returned false.")
    calendar = source_calendar(source, registry, modules)
    calendar["readonly"] = False
    component = modules.ECal.Component.new_from_icalcomponent(ical.clone())
    event = component_event(component, calendar)
    merge_cache_event(event)
    return {"ok": True, "provider": "evolution-data-server", "calendar": calendar, "event": event, "uid": created_uid or uid}


def apply_meeting(kind: str, url: str, location: str) -> str:
    kind = str(kind or "none").strip().lower()
    if kind in ("", "none"):
        return location
    found, _provider = meeting_from_text(url or location)
    if kind in ("link", "meet", "zoom", "teams") and not found:
        raise ValueError("Paste a Zoom, Google Meet, or Teams link.")
    if found and found not in str(location or ""):
        return f"{location} · {found}" if location else found
    return location


def extract_rrule(component) -> str:
    ical = component.get_icalcomponent() if hasattr(component, "get_icalcomponent") else component
    text = ical.as_ical_string() if ical is not None and hasattr(ical, "as_ical_string") else ""
    for raw in str(text).replace("\r\n ", "").replace("\n ", "").splitlines():
        line = raw.strip()
        if line.upper().startswith("RRULE:"):
            return line.split(":", 1)[1].strip()
    return ""


def eds_update_event(calendar_id: str, uid: str, rid: str, title: str, start: datetime, end: datetime, all_day: bool, location: str, description: str, scope: str = "", to_calendar_id: str = "") -> dict:
    if not uid:
        raise ValueError("update-event requires --uid.")
    modules, registry, source, client = eds_client_for_calendar(calendar_id)
    if client.is_readonly():
        raise ValueError(f"Calendar is read-only: {source.get_display_name()}")

    ok, existing = client.get_object_sync(uid, None, None)
    if not ok or existing is None:
        raise ValueError(f"Event not found: {uid}")

    dest_id = str(to_calendar_id or "").strip()
    if dest_id and dest_id != calendar_id:
        rrule = "" if (scope == "this" and rid) else extract_rrule(existing)
        payload = eds_create_event(dest_id, title, start, end, all_day, location, description, rrule)
        eds_delete_event(calendar_id, uid, rid if scope == "this" and rid else "")
        return payload

    keep_date = scope == "all"
    mod = modules.ECal.ObjModType.THIS if scope == "this" and rid else modules.ECal.ObjModType.ALL
    old_start = existing.get_dtstart()
    old_end = existing.get_dtend()
    tzid = old_start.get_tzid() if old_start else ""
    zone = resolve_ical_timezone(modules, tzid, client)
    utc_zone = modules.ICalGLib.Timezone.get_utc_timezone()

    def to_ical(dt, template):
        stamp = modules.ICalGLib.Time.new_from_timet_with_zone(int(dt.timestamp()), 0, utc_zone)
        if zone is not None:
            stamp = stamp.convert_to_zone(zone)
            stamp.set_timezone(zone)
        if keep_date and template is not None and not template.is_date():
            stamp.set_year(template.get_year())
            stamp.set_month(template.get_month())
            stamp.set_day(template.get_day())
        return stamp

    existing.set_summary(title or "(No title)")
    if hasattr(existing, "set_location"):
        existing.set_location(location or "")
    if all_day:
        def to_date(dt):
            stamp = modules.ICalGLib.Time.new_from_string(dt.strftime("%Y%m%d"))
            if stamp is not None and hasattr(stamp, "set_is_date"):
                stamp.set_is_date(1)
            return stamp

        existing.set_dtstart(to_date(start))
        existing.set_dtend(to_date(end))
    else:
        existing.set_dtstart(to_ical(start, old_start))
        existing.set_dtend(to_ical(end, old_end))
    ok = client.modify_object_sync(existing, mod, modules.ECal.OperationFlags.DISABLE_ITIP_MESSAGE, None)
    if not ok:
        raise ValueError("EDS modify_object_sync returned false.")
    calendar = source_calendar(source, registry, modules)
    calendar["readonly"] = False
    component = modules.ECal.Component.new_from_icalcomponent(existing.clone())
    event = component_event(component, calendar, modules, client)
    merge_cache_event(event, series=not bool(rid))
    return {"ok": True, "provider": "evolution-data-server", "calendar": calendar, "event": event, "uid": uid, "rid": rid}


def eds_delete_event(calendar_id: str, uid: str, rid: str = "") -> dict:
    modules, registry, source, client = eds_client_for_calendar(calendar_id)
    if client.is_readonly():
        raise ValueError(f"Calendar is read-only: {source.get_display_name()}")
    mod = modules.ECal.ObjModType.THIS if rid else modules.ECal.ObjModType.ALL
    ok = client.remove_object_sync(uid, rid or None, mod, modules.ECal.OperationFlags.DISABLE_ITIP_MESSAGE, None)
    if not ok:
        raise ValueError("EDS remove_object_sync returned false.")
    if rid:
        remove_cache_event(":".join(part for part in [source.get_uid(), uid, rid] if part))
    else:
        cache = read_cache()
        if cache:
            for event in cache.get("events") or []:
                if event.get("uid") == uid and event.get("calendarId") == source.get_uid():
                    note_event_touch(cache, event, "delete")
            note_local_touch(cache, source.get_uid(), uid, "delete")
            cache["events"] = [event for event in (cache.get("events") or []) if event.get("uid") != uid or event.get("calendarId") != source.get_uid()]
            write_cache(cache, bump=True)
    return {"ok": True, "provider": "evolution-data-server", "calendarId": source.get_uid(), "uid": uid, "rid": rid}


def eds_attach_discovered_calendars(modules: EdsModules, registry, parent, credentials, username: str, host: str, port: int, committed: list | None = None) -> list:
    result = modules.EDataServer.webdav_discover_sources_sync(
        parent,
        None,
        modules.EDataServer.WebDAVDiscoverSupports.EVENTS,
        credentials,
        None,
    )
    discovered = []
    if isinstance(result, tuple):
        ok = result[0]
        sources = result[3] if len(result) > 3 else []
        if not ok:
            raise ValueError("Could not discover calendars on that CalDAV server.")
        discovered = list(sources or [])
    elif result:
        discovered = list(result)

    calendars = []
    event_flag = int(modules.EDataServer.WebDAVDiscoverSupports.EVENTS)
    for item in discovered:
        supports = int(getattr(item, "supports", 0) or 0)
        href = str(getattr(item, "href", "") or "").strip()
        if not href or (supports and (supports & event_flag) == 0):
            continue
        child = modules.EDataServer.Source.new_with_uid(f"omarchy-calendar-caldav-{uuid4()}", None)
        child.set_display_name(str(getattr(item, "display_name", "") or parent.get_display_name() or "Calendar"))
        child.set_enabled(True)

        calendar = child.get_extension(modules.EDataServer.SOURCE_EXTENSION_CALENDAR)
        calendar.set_backend_name("caldav")
        calendar.set_selected(True)
        color = str(getattr(item, "color", "") or "")
        if color:
            calendar.set_color(color)

        uri = modules.GLib.Uri.parse(href, modules.GLib.UriFlags.NONE)
        webdav = child.get_extension(modules.EDataServer.SOURCE_EXTENSION_WEBDAV_BACKEND)
        webdav.set_uri(uri)
        webdav.set_display_name(child.get_display_name())
        if color:
            webdav.set_color(color)
        webdav.set_calendar_auto_schedule(True)

        child_host = uri.get_host() or host
        child_port = uri.get_port()
        if child_port < 0:
            child_port = 443 if (uri.get_scheme() or "https") == "https" else port
        auth = child.get_extension(modules.EDataServer.SOURCE_EXTENSION_AUTHENTICATION)
        auth.set_host(child_host)
        auth.set_port(child_port)
        auth.set_user(username)
        auth.set_method("plain/password")
        auth.set_remember_password(True)

        child = commit_new_source(registry, child)
        if child is None:
            raise ValueError("Failed to save a discovered calendar source.")
        if committed is not None:
            committed.append(child)
        cred_provider = modules.EDataServer.SourceCredentialsProvider.new(registry)
        if cred_provider.can_store(child):
            cred_provider.store_sync(child, credentials, True, None)
        calendars.append(source_calendar(child, registry, modules))

    if not calendars:
        raise ValueError("Connected, but no calendars were found on that CalDAV server.")
    return calendars


DAV_NS = "{DAV:}"
CALDAV_NS = "{urn:ietf:params:xml:ns:caldav}"
MAX_CALDAV_CANDIDATES = 3
PROPFIND_BODY = b"""<?xml version="1.0" encoding="utf-8"?>
<d:propfind xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">
  <d:prop>
    <d:resourcetype/>
    <d:displayname/>
    <d:current-user-principal/>
    <c:calendar-home-set/>
  </d:prop>
</d:propfind>
"""


def normalize_caldav_url(url: str) -> str:
    text = str(url or "").strip()
    if text and not text.startswith("http://") and not text.startswith("https://"):
        return "https://" + text
    return text


def caldav_hostname(url: str) -> str:
    return (urlsplit(url).hostname or "").lower().rstrip(".")


def is_forwardemail_host(host: str) -> bool:
    return host == "caldav.forwardemail.net" or host.endswith(".forwardemail.net")


def caldav_url_with_path(url: str, path: str) -> str:
    return urlsplit(url)._replace(path=path, query="", fragment="").geturl()


def caldav_candidate_urls(url: str, username: str = "") -> list[str]:
    parsed = urlsplit(url)
    path = parsed.path or ""
    if path not in ("", "/"):
        return [url]
    user = str(username or "").strip()
    host = caldav_hostname(url)
    if is_forwardemail_host(host):
        candidates = [caldav_url_with_path(url, "/dav/")]
        if user:
            candidates.insert(0, caldav_url_with_path(url, f"/dav/{user}/"))
        return candidates[:MAX_CALDAV_CANDIDATES]
    return [url]


def parse_caldav_multistatus(xml_bytes: bytes, base_url: str) -> tuple[list[dict], list[str], list[str]]:
    root = ET.fromstring(xml_bytes)
    calendars = []
    homes = []
    principals = []
    for response in root.iter(f"{DAV_NS}response"):
        href = (response.findtext(f"{DAV_NS}href") or "").strip()
        absolute = urljoin(base_url if base_url.endswith("/") else base_url + "/", href)
        resourcetype = response.find(f".//{DAV_NS}resourcetype")
        is_calendar = resourcetype is not None and resourcetype.find(f"{CALDAV_NS}calendar") is not None
        name = (response.findtext(f".//{DAV_NS}displayname") or "").strip()
        if is_calendar:
            calendars.append({"href": absolute, "name": name})
        for home in response.iter(f"{CALDAV_NS}calendar-home-set"):
            home_href = (home.findtext(f"{DAV_NS}href") or "").strip()
            if home_href:
                homes.append(urljoin(absolute, home_href))
        for principal in response.iter(f"{DAV_NS}current-user-principal"):
            principal_href = (principal.findtext(f"{DAV_NS}href") or "").strip()
            if principal_href:
                principals.append(urljoin(absolute, principal_href))
    return calendars, homes, principals


def caldav_propfind(url: str, username: str, password: str, timeout: float = 8.0) -> tuple[int, bytes]:
    request = urllib.request.Request(url, data=PROPFIND_BODY, method="PROPFIND")
    request.add_header("Depth", "1")
    request.add_header("Content-Type", "application/xml; charset=utf-8")
    request.add_header("User-Agent", "CalDav-Calendar/1.0")
    manager = urllib.request.HTTPPasswordMgrWithDefaultRealm()
    parsed = urlsplit(url)
    origin = f"{parsed.scheme}://{parsed.netloc}"
    manager.add_password(None, origin, username, password)
    opener = urllib.request.build_opener(urllib.request.HTTPBasicAuthHandler(manager))
    try:
        with opener.open(request, timeout=timeout) as response:
            return int(getattr(response, "status", 200) or 200), response.read()
    except urllib.error.HTTPError as error:
        return int(error.code), error.read() if error.fp else b""
    except TimeoutError as error:
        raise ValueError("Calendar server timed out.") from error
    except urllib.error.URLError as error:
        raise ValueError("Could not reach that CalDAV server.") from error


def discover_caldav_calendars(url: str, username: str, password: str) -> list[dict]:
    pending = caldav_candidate_urls(url, username)
    seen: set[str] = set()
    found: list[dict] = []
    while pending and len(seen) < 4:
        current = pending.pop(0)
        if current in seen:
            continue
        seen.add(current)
        status, body = caldav_propfind(current, username, password)
        if status in (401, 403):
            raise ValueError("Username or password was rejected.")
        if status not in (200, 207) or not body:
            continue
        calendars, homes, principals = parse_caldav_multistatus(body, current)
        for calendar in calendars:
            if calendar["href"] not in {item["href"] for item in found}:
                found.append(calendar)
        for extra in homes + principals:
            if extra not in seen and extra not in pending:
                pending.append(extra)
    return found


def glib_parse_uri(modules: EdsModules, url: str):
    flags = [modules.GLib.UriFlags.NONE]
    encoded = getattr(modules.GLib.UriFlags, "ENCODED", None)
    if encoded is not None:
        flags.append(encoded)
    last_error = None
    for flag in flags:
        try:
            return modules.GLib.Uri.parse(url, flag)
        except Exception as error:
            last_error = error
    raise last_error or ValueError("CalDAV URL could not be parsed.")


def eds_add_direct_calendar(modules: EdsModules, registry, href: str, display_name: str, username: str, password: str, committed: list) -> dict:
    source = modules.EDataServer.Source.new_with_uid(f"omarchy-calendar-caldav-{uuid4()}", None)
    source.set_display_name(display_name or "Calendar")
    source.set_enabled(True)
    calendar = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_CALENDAR)
    calendar.set_backend_name("caldav")
    calendar.set_selected(True)
    uri = glib_parse_uri(modules, href)
    webdav = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_WEBDAV_BACKEND)
    webdav.set_uri(uri)
    webdav.set_display_name(source.get_display_name())
    webdav.set_calendar_auto_schedule(True)
    host = uri.get_host() or ""
    port = uri.get_port()
    if port < 0:
        port = 443 if (uri.get_scheme() or "https") == "https" else 80
    auth = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_AUTHENTICATION)
    auth.set_host(host)
    auth.set_port(port)
    auth.set_user(username)
    auth.set_method("plain/password")
    auth.set_remember_password(True)
    source = commit_new_source(registry, source)
    if source is None:
        raise ValueError("Failed to save a discovered calendar source.")
    committed.append(source)
    credentials = modules.EDataServer.NamedParameters.new()
    credentials.set(modules.EDataServer.SOURCE_CREDENTIAL_USERNAME, username)
    credentials.set(modules.EDataServer.SOURCE_CREDENTIAL_PASSWORD, password)
    provider = modules.EDataServer.SourceCredentialsProvider.new(registry)
    if provider.can_store(source):
        provider.store_sync(source, credentials, True, None)
    return source_calendar(source, registry, modules)


def eds_setup_caldav_propfind(display_name: str, url: str, username: str, password: str) -> dict:
    found = discover_caldav_calendars(url, username, password)
    if not found:
        raise ValueError("Connected, but no calendars were found on that CalDAV server.")
    modules = load_eds_modules()
    registry = modules.EDataServer.SourceRegistry.new_sync(None)
    committed: list = []
    calendars = []
    try:
        for index, item in enumerate(found):
            name = item.get("name") or (display_name if index == 0 else f"{display_name} {index + 1}")
            added = eds_add_direct_calendar(modules, registry, item["href"], name, username, password, committed)
            added["readonly"] = False
            calendars.append(added)
    except Exception:
        for created in reversed(committed):
            discard_committed_source(registry, created.get_uid())
        raise
    merge_cache_calendars(calendars)
    return {
        "ok": True,
        "provider": "evolution-data-server",
        "calendar": calendars[0],
        "calendars": calendars,
    }


def eds_setup_caldav(payload: dict) -> dict:
    display_name = str(payload.get("displayName") or "Calendar").strip()
    url = str(payload.get("url") or "").strip()
    username = str(payload.get("username") or "").strip()
    password = str(payload.get("password") or "")
    if not url:
        raise ValueError("CalDAV URL is required.")
    if not username:
        raise ValueError("Username is required.")
    if not password:
        raise ValueError("Password is required.")
    if any(character.isspace() for character in url):
        raise ValueError("CalDAV URL cannot contain spaces.")
    if not url.startswith("http://") and not url.startswith("https://"):
        url = "https://" + url
    parsed = urlsplit(url)
    if parsed.scheme not in ("http", "https") or not parsed.netloc or not parsed.hostname:
        raise ValueError("CalDAV URL must include http(s) scheme and host.")
    if any(character.isspace() for character in parsed.hostname):
        raise ValueError("CalDAV URL host cannot contain spaces.")
    if is_forwardemail_host(caldav_hostname(url)):
        return eds_setup_caldav_propfind(display_name, url, username, password)

    modules = load_eds_modules()
    registry = modules.EDataServer.SourceRegistry.new_sync(None)
    uri = modules.GLib.Uri.parse(url, modules.GLib.UriFlags.NONE)
    host = uri.get_host() or ""
    port = uri.get_port()
    if port < 0:
        port = 443 if uri.get_scheme() == "https" else 80
    if not host:
        raise ValueError("CalDAV URL must include a host.")

    source = modules.EDataServer.Source.new_with_uid(f"omarchy-calendar-caldav-{uuid4()}", None)
    source.set_display_name(display_name)
    source.set_enabled(True)

    collection = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_COLLECTION)
    collection.set_backend_name("webdav")
    collection.set_identity(username)
    collection.set_calendar_enabled(True)
    collection.set_contacts_enabled(False)
    collection.set_mail_enabled(False)
    if hasattr(collection, "set_calendar_url"):
        collection.set_calendar_url(url)

    webdav = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_WEBDAV_BACKEND)
    webdav.set_uri(uri)
    webdav.set_display_name(display_name)
    webdav.set_color("#8aadf4")
    webdav.set_calendar_auto_schedule(True)

    auth = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_AUTHENTICATION)
    auth.set_host(host)
    auth.set_port(port)
    auth.set_user(username)
    auth.set_method("plain/password")
    auth.set_remember_password(True)
    auth.set_credential_name("CalDAV")

    offline = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_OFFLINE)
    offline.set_stay_synchronized(True)

    refresh = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_REFRESH)
    refresh.set_enabled(True)
    refresh.set_interval_minutes(15)

    committed = []
    try:
        source = commit_new_source(registry, source)
        if source is None:
            raise ValueError("Failed to commit EDS CalDAV source.")
        committed.append(source)

        credentials = modules.EDataServer.NamedParameters.new()
        credentials.set(modules.EDataServer.SOURCE_CREDENTIAL_USERNAME, username)
        credentials.set(modules.EDataServer.SOURCE_CREDENTIAL_PASSWORD, password)
        provider = modules.EDataServer.SourceCredentialsProvider.new(registry)
        if not provider.can_store(source):
            raise ValueError("Evolution Data Server cannot store credentials for this source.")
        provider.store_sync(source, credentials, True, None)

        calendars = eds_attach_discovered_calendars(modules, registry, source, credentials, username, host, port, committed)
        quiet_omarchy_collection(source, registry, modules)
    except Exception:
        for created in reversed(committed):
            discard_committed_source(registry, created.get_uid())
        raise

    return {
        "ok": True,
        "provider": "evolution-data-server",
        "calendar": source_calendar(source, registry, modules),
        "calendars": calendars,
    }


SYNC_REPORT_BODY = """<?xml version="1.0" encoding="utf-8"?>
<d:sync-collection xmlns:d="DAV:" xmlns:c="urn:ietf:params:xml:ns:caldav">
  <d:sync-token>{token}</d:sync-token>
  <d:sync-level>1</d:sync-level>
  <d:prop>
    <d:getetag/>
    <c:calendar-data/>
  </d:prop>
</d:sync-collection>
"""
SYNC_PROBE_BODY = b"""<?xml version="1.0" encoding="utf-8"?>
<d:propfind xmlns:d="DAV:" xmlns:cs="http://calendarserver.org/ns/">
  <d:prop>
    <d:supported-report-set/>
    <d:sync-token/>
    <cs:getctag/>
  </d:prop>
</d:propfind>
"""
CS_NS = "{http://calendarserver.org/ns/}"


def lookup_source_credentials(source, registry, modules: EdsModules) -> tuple[str, str]:
    try:
        provider = modules.EDataServer.SourceCredentialsProvider.new(registry)
        result = provider.lookup_sync(source, None)
    except Exception:
        return "", ""
    creds = result[1] if isinstance(result, tuple) and len(result) > 1 else result
    if creds is None:
        return "", ""
    username = ""
    password = ""
    try:
        username = creds.get(modules.EDataServer.SOURCE_CREDENTIAL_USERNAME) or ""
        password = creds.get(modules.EDataServer.SOURCE_CREDENTIAL_PASSWORD) or ""
    except Exception:
        username, password = "", ""
    if not username and source.has_extension(modules.EDataServer.SOURCE_EXTENSION_AUTHENTICATION):
        username = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_AUTHENTICATION).get_user() or ""
    return str(username), str(password)


def caldav_http(method: str, url: str, username: str, password: str, body: bytes = b"", headers: dict | None = None, timeout: float = 25.0) -> tuple[int, bytes, object]:
    request = urllib.request.Request(url, data=body or None, method=method)
    request.add_header("User-Agent", "CalDav-Calendar/1.0")
    for key, value in (headers or {}).items():
        request.add_header(key, value)
    manager = urllib.request.HTTPPasswordMgrWithDefaultRealm()
    parsed = urlsplit(url)
    origin = f"{parsed.scheme}://{parsed.netloc}"
    manager.add_password(None, origin, username, password)
    opener = urllib.request.build_opener(urllib.request.HTTPBasicAuthHandler(manager))
    try:
        with opener.open(request, timeout=timeout) as response:
            return int(getattr(response, "status", 200) or 200), response.read(), response.headers
    except urllib.error.HTTPError as error:
        return int(error.code), error.read() if error.fp else b"", error.headers
    except Exception as error:
        sync_log("sync-http-error", method=method, host=parsed.hostname or "", error=str(error)[:200])
        return 0, b"", None


def href_event_uid(href: str) -> str:
    name = urlsplit(href).path.rstrip("/").rsplit("/", 1)[-1]
    if name.endswith(".ics"):
        name = name[:-4]
    return unquote(name)


def href_is_event_resource(href: str) -> bool:
    path = urlsplit(str(href or "")).path
    return bool(path) and not path.endswith("/")


def parse_sync_support(xml_bytes: bytes) -> tuple[bool, str]:
    supported, token, _ctag = parse_sync_probe(xml_bytes)
    return supported, token


def parse_sync_probe(xml_bytes: bytes) -> tuple[bool, str, str]:
    if not xml_bytes:
        return False, "", ""
    try:
        root = ET.fromstring(xml_bytes)
    except ET.ParseError:
        return False, "", ""
    token = ""
    ctag = ""
    for node in root.iter(f"{DAV_NS}sync-token"):
        if (node.text or "").strip():
            token = (node.text or "").strip()
            break
    for node in root.iter(f"{CS_NS}getctag"):
        if (node.text or "").strip():
            ctag = (node.text or "").strip()
            break
    reports = " ".join((node.text or "") + "".join(node.itertext()) for node in root.iter(f"{DAV_NS}supported-report-set"))
    names = " ".join(node.tag for node in root.iter())
    supported = bool(token) or "sync-collection" in reports or "sync-collection" in names
    return supported, token, ctag


def parse_sync_collection(xml_bytes: bytes, base_url: str) -> tuple[str, list[dict], list[str], bool]:
    root = ET.fromstring(xml_bytes)
    token = ""
    for node in root.iter(f"{DAV_NS}sync-token"):
        if (node.text or "").strip():
            token = (node.text or "").strip()
    changed = []
    removed = []
    truncated = False
    for response in root.iter(f"{DAV_NS}response"):
        href = (response.findtext(f"{DAV_NS}href") or "").strip()
        if not href:
            continue
        absolute = urljoin(base_url if base_url.endswith("/") else base_url + "/", href)
        if not href_is_event_resource(absolute):
            continue
        status_text = " ".join((node.text or "") for node in response.iter(f"{DAV_NS}status"))
        if "404" in status_text:
            removed.append(href_event_uid(absolute))
            continue
        if "507" in status_text:
            truncated = True
            continue
        calendar_data = ""
        for node in response.iter(f"{CALDAV_NS}calendar-data"):
            calendar_data = "".join(node.itertext()).strip()
            if calendar_data:
                break
        changed.append({"href": absolute, "uid": href_event_uid(absolute), "ics": calendar_data})
    return token, changed, removed, truncated


def event_sync_keys(event: dict | None) -> set[str]:
    keys = set()
    for field in ("uid", "hrefUid"):
        value = str((event or {}).get(field) or "")
        if value:
            keys.add(value)
    return keys


def apply_sync_delta(cached_events: list, removed_uids: list, new_events: list, keep_uids: list | None = None, drop_uids: list | None = None) -> list:
    replaced = {str(uid) for uid in removed_uids if uid}
    drop = {str(uid) for uid in (drop_uids or []) if uid}
    keep = {str(uid) for uid in (keep_uids or []) if uid} - drop
    for event in new_events:
        replaced |= event_sync_keys(event)
    replaced -= keep
    replaced |= drop
    kept = [event for event in cached_events if event_sync_keys(event).isdisjoint(replaced)]
    added = [event for event in new_events if event_sync_keys(event).isdisjoint(drop)]
    return kept + added


def ecal_components_from_ics(ics_text: str, modules: EdsModules) -> list:
    text = str(ics_text or "").strip()
    if not text:
        return []
    if "BEGIN:VCALENDAR" not in text.upper():
        text = "BEGIN:VCALENDAR\r\n" + text + "\r\nEND:VCALENDAR\r\n"
    try:
        component = modules.ECal.Component.new_from_string(text)
    except Exception:
        component = None
    if component is not None:
        return [component]
    try:
        root = modules.ICalGLib.Component.new_from_string(text)
    except Exception:
        return []
    if root is None:
        return []
    kind = modules.ICalGLib.ComponentKind.VEVENT_COMPONENT
    name = str(root.get_component_name() or "").upper() if hasattr(root, "get_component_name") else ""
    nodes = []
    if name == "VEVENT":
        nodes = [root]
    else:
        child = root.get_first_component(kind)
        while child is not None:
            nodes.append(child)
            child = root.get_next_component(kind)
    components = []
    for node in nodes:
        item = None
        try:
            item = modules.ECal.Component.new_from_icalcomponent(node)
        except Exception:
            item = None
        if item is None and hasattr(node, "as_ical_string"):
            try:
                item = modules.ECal.Component.new_from_string(node.as_ical_string())
            except Exception:
                item = None
        if item is not None:
            components.append(item)
    return components


def events_from_ics(ics_text: str, calendar: dict, client, modules: EdsModules, window_start: datetime, window_end: datetime) -> tuple[list, bool]:
    components = ecal_components_from_ics(ics_text, modules)
    if not components:
        return [], False
    events: list = []
    incomplete = False
    for component in components:
        before = len(events)
        append_component_events(client, component, calendar, window_start, window_end, events, modules)
        recurring = hasattr(component, "has_recurrences") and component.has_recurrences()
        if len(events) == before or (recurring and client is None):
            incomplete = True
    return events, bool(events) and not incomplete


def ics_missing_vevent(ics_text: str) -> bool:
    return "BEGIN:VEVENT" not in str(ics_text or "").upper()


def ingest_changed_items(changed: list, calendar: dict, client, modules: EdsModules, window_start: datetime, window_end: datetime, username: str, password: str) -> tuple[list, list]:
    new_events = []
    failed_uids = []
    for item in changed:
        ics = item.get("ics") or ""
        if ics_missing_vevent(ics) and item.get("href"):
            _status, raw, _hdrs = caldav_http("GET", item["href"], username, password, b"", {})
            if _status == 200:
                ics = raw.decode("utf-8", "replace")
            else:
                sync_log("sync-ics-get-failed", href=str(item.get("href") or "")[:160], status=_status)
                if _status in (400, 404, 405, 410):
                    continue
                if item.get("uid"):
                    failed_uids.append(str(item["uid"]))
                continue
        parsed, complete = events_from_ics(ics, calendar, client, modules, window_start, window_end)
        href_uid = str(item.get("uid") or "")
        if complete and parsed:
            for event in parsed:
                if href_uid:
                    event["hrefUid"] = href_uid
            new_events.extend(parsed)
        else:
            sync_log("sync-ics-parse-failed", hrefUid=href_uid, hasVevent=not ics_missing_vevent(ics), bytes=len(ics or ""))
            if href_uid:
                failed_uids.append(href_uid)
            failed_uids.extend(str(event.get("uid") or "") for event in parsed if event.get("uid"))
    return new_events, failed_uids


def sync_state_map(cache: dict | None) -> dict:
    state = (cache or {}).get("syncState") or {}
    return state if isinstance(state, dict) else {}


def mark_sync_unsupported(state: dict, calendar_id: str) -> None:
    previous = state.get(calendar_id) if isinstance(state.get(calendar_id), dict) else {}
    state[calendar_id] = {"supported": False, "token": "", "ctag": str(previous.get("ctag") or "")}


def remember_sync_state(state: dict, calendar_id: str, **fields) -> dict:
    current = dict(state.get(calendar_id) if isinstance(state.get(calendar_id), dict) else {})
    current.update(fields)
    state[calendar_id] = current
    return current


def ctag_decision(state: dict, calendar_id: str, ctag: str, if_changed: bool) -> str:
    current = state.get(calendar_id) if isinstance(state.get(calendar_id), dict) else {}
    old = str(current.get("ctag") or "")
    if ctag and old and ctag == old:
        sync_log("sync-ctag-unchanged", calendarId=calendar_id, ctag=ctag)
        return "unchanged"
    if ctag:
        remember_sync_state(state, calendar_id, ctag=ctag)
    if if_changed and (not ctag or not old):
        sync_log("sync-ctag-baseline", calendarId=calendar_id, ctag=ctag)
        return "unchanged"
    sync_log("sync-ctag-changed", calendarId=calendar_id, ctag=ctag, previous=old, ifChanged=if_changed)
    return "eds"


def apply_collection_report(href: str, username: str, password: str, token: str, calendar: dict, client, source, modules: EdsModules, window_start: datetime, window_end: datetime, cache: dict | None, state: dict, calendar_id: str, ctag: str, cached_events: list, if_changed: bool, replace: bool = False) -> tuple[str, list, list]:
    body = SYNC_REPORT_BODY.format(token=token.replace("&", "&amp;").replace("<", "&lt;").replace(">", "&gt;")).encode("utf-8")
    status, payload, _headers = caldav_http("REPORT", href, username, password, body, {"Depth": "0", "Content-Type": "application/xml; charset=utf-8"})
    if status in (403, 409, 412):
        remember_sync_state(state, calendar_id, supported=True, token="", ctag=ctag)
        sync_log("sync-6578-reset", calendarId=calendar_id, status=status, ifChanged=if_changed)
        return "eds", [], []
    if status in (415, 501):
        mark_sync_unsupported(state, calendar_id)
        if if_changed:
            return ctag_decision(state, calendar_id, ctag, True), [], []
        return "eds", [], []
    if status not in (200, 207):
        return (("unchanged", [], []) if if_changed else ("eds", [], []))
    try:
        next_token, changed, removed, truncated = parse_sync_collection(payload, href)
    except ET.ParseError:
        return "eds", [], []
    remote_uids = [str(uid) for uid in removed if uid]
    remote_uids.extend(str(item.get("uid") or "") for item in changed if item.get("uid"))
    if cache is not None:
        removed_map = cache.get("_removed") if isinstance(cache.get("_removed"), dict) else {}
        removed_map[calendar_id] = [str(uid) for uid in removed if uid]
        cache["_removed"] = removed_map
    if truncated:
        sync_log("sync-6578-truncated", calendarId=calendar_id, token=token)
        return (("unchanged", [], remote_uids) if if_changed else ("eds", [], remote_uids))
    parse_client = client
    if changed and parse_client is None and source is not None:
        try:
            parse_client = modules.ECal.Client.connect_sync(source, modules.ECal.ClientSourceType.EVENTS, 10, None)
        except Exception:
            parse_client = None
    new_events, failed_uids = ingest_changed_items(changed, calendar, parse_client, modules, window_start, window_end, username, password)
    remote_uids.extend(str(event.get("uid") or "") for event in new_events if event.get("uid"))
    drop_uids = deleted_touch_keys(cache, calendar_id)
    failed_keep = [uid for uid in failed_uids if uid not in drop_uids]
    if failed_uids:
        sync_log("sync-6578-parse-failed", calendarId=calendar_id, failed=failed_uids[:8], changed=len(changed))
        if replace:
            return (("unchanged", [], remote_uids) if if_changed else ("eds", [], remote_uids))
        return "updated", apply_sync_delta(cached_events, removed, new_events, keep_uids=failed_keep, drop_uids=drop_uids), remote_uids
    if next_token:
        remember_sync_state(state, calendar_id, supported=True, token=next_token, ctag=ctag or next_token, filled=True)
        if cache is not None:
            cache["syncState"] = state
    if replace:
        sync_log("sync-6578-full", calendarId=calendar_id, pulled=len(new_events), token=next_token or token)
        return "updated", new_events, remote_uids
    if not changed and not removed:
        sync_log("sync-6578-unchanged", calendarId=calendar_id, token=next_token or token)
        return "unchanged", [], remote_uids
    merged = apply_sync_delta(cached_events, removed, new_events, keep_uids=failed_keep, drop_uids=drop_uids)
    sync_log("sync-6578-updated", calendarId=calendar_id, changed=len(changed), removed=removed, token=next_token or token)
    return "updated", merged, remote_uids


def caldav_sync_calendar(source, registry, modules: EdsModules, calendar: dict, client, cache: dict | None, window_start: datetime, window_end: datetime, if_changed: bool = False) -> tuple[str, list, list]:
    calendar_id = calendar["id"]
    state = sync_state_map(cache)
    current = state.get(calendar_id) if isinstance(state.get(calendar_id), dict) else {}
    href = source_webdav_url(source, modules)
    username, password = lookup_source_credentials(source, registry, modules)
    cached_events = [event for event in ((cache or {}).get("events") or []) if (event or {}).get("calendarId") == calendar_id]
    fe = is_forwardemail_host(str(calendar.get("host") or ""))
    if not href or not username or not password:
        sync_log("sync-skip-no-creds", calendarId=calendar_id, ifChanged=if_changed)
        return (("unchanged", [], []) if if_changed else ("eds", [], []))
    token = str(current.get("token") or "")
    ctag = str(current.get("ctag") or "")
    if cache is not None:
        cache["syncState"] = state
    if current.get("supported") is True and token:
        pass
    else:
        status, body, _headers = caldav_http("PROPFIND", href, username, password, SYNC_PROBE_BODY, {"Depth": "0", "Content-Type": "application/xml; charset=utf-8"})
        supported, probed_token, ctag = parse_sync_probe(body) if status in (200, 207) else (False, "", "")
        if cache is not None:
            cache["syncState"] = state
        if current.get("supported") is False or (status in (200, 207) and not supported and current.get("supported") is not True):
            mark_sync_unsupported(state, calendar_id)
            if ctag:
                remember_sync_state(state, calendar_id, supported=False, ctag=ctag)
            return ctag_decision(state, calendar_id, ctag, if_changed), [], []
        token = str(current.get("token") or "")
        if current.get("supported") is not True:
            if status not in (200, 207) or not supported:
                mark_sync_unsupported(state, calendar_id)
                if ctag:
                    remember_sync_state(state, calendar_id, supported=False, ctag=ctag)
                if if_changed:
                    return ctag_decision(state, calendar_id, ctag, True), [], []
                return "eds", [], []
            remember_sync_state(state, calendar_id, supported=True, token=token or probed_token, ctag=ctag)
            sync_log("sync-6578-first", calendarId=calendar_id, ifChanged=if_changed, token=token or probed_token, ctag=ctag)
            if fe:
                return apply_collection_report(href, username, password, "", calendar, client, source, modules, window_start, window_end, cache, state, calendar_id, ctag, cached_events, if_changed, replace=True)
            return "eds", [], []
    if fe and (not token or (not cached_events and current.get("filled") is not True)):
        sync_log("sync-6578-recover", calendarId=calendar_id, cached=len(cached_events), token=token)
        return apply_collection_report(href, username, password, "", calendar, client, source, modules, window_start, window_end, cache, state, calendar_id, ctag, cached_events, if_changed, replace=True)
    if not token:
        if if_changed:
            return "unchanged", [], []
        return "eds", [], []
    result = apply_collection_report(href, username, password, token, calendar, client, source, modules, window_start, window_end, cache, state, calendar_id, ctag, cached_events, if_changed)
    if result[0] == "eds" and fe:
        remember_sync_state(state, calendar_id, supported=True, token="", ctag=ctag)
        sync_log("sync-6578-recover", calendarId=calendar_id, reason="eds-fallback")
        return apply_collection_report(href, username, password, "", calendar, client, source, modules, window_start, window_end, cache, state, calendar_id, ctag, cached_events, if_changed, replace=True)
    return result


def eds_pull_calendar_events(client, calendar: dict, window_start: datetime, window_end: datetime, modules: EdsModules, events: list) -> None:
    query = eds_range_query(window_start, window_end)
    ok, components = client.get_object_list_as_comps_sync(query, None)
    if not ok:
        return
    for component in components or []:
        if len(events) >= MAX_EVENTS:
            break
        append_component_events(client, component, calendar, window_start, window_end, events, modules)
    if len(events) > MAX_EVENTS:
        del events[MAX_EVENTS:]


def eds_snapshot(start: datetime, end: datetime, include_events: bool = True, if_changed: bool = False) -> dict:
    try:
        modules = load_eds_modules()
        registry = modules.EDataServer.SourceRegistry.new_sync(None)
    except Exception as error:  # pragma: no cover - depends on host packages
        return {
            "ok": False,
            "provider": "evolution-data-server",
            "calendars": [],
            "events": [],
            "error": {
                "code": "eds-bindings-missing",
                "message": "Evolution Data Server is not installed. It is required to store calendar data locally.",
                "detail": str(error),
            },
        }

    calendars = []
    events = []
    errors = []
    eds_prune_duplicate_caldav(registry, modules)
    cache = read_cache() or {"ok": True, "calendars": [], "events": [], "syncState": {}}
    start_rev = cache_rev(cache)
    start_state = json.loads(json.dumps(sync_state_map(cache)))
    calendar_modes: dict[str, str] = {}
    remote_touches: dict[str, list] = {}
    sync_log("snapshot-start", ifChanged=if_changed, includeEvents=include_events, rev=start_rev)
    sources = list(registry.list_sources(modules.EDataServer.SOURCE_EXTENSION_CALENDAR))
    sources.sort(key=lambda item: (0 if is_omarchy_source_uid(item.get_uid()) else 1, item.get_display_name() or ""))
    window_start = min(start, datetime.now(UTC) - timedelta(days=400))
    window_end = max(end, datetime.now(UTC) + timedelta(days=400))
    seen_caldav = set()

    for source in sources:
        if not registry.check_enabled(source):
            continue
        if is_unresolved_caldav_root(source, registry, modules):
            continue
        key = caldav_source_key(source, modules)
        if key is not None:
            if key in seen_caldav:
                continue
            seen_caldav.add(key)
        calendar = source_calendar(source, registry, modules)
        listed = False
        client = None
        try:
            calendars.append(calendar)
            listed = True
            if not include_events:
                continue
            mode, synced, remote_uids = ("eds", [], [])
            if source_provider(source, registry, modules) == "caldav":
                try:
                    mode, synced, remote_uids = caldav_sync_calendar(source, registry, modules, calendar, None, cache, window_start, window_end, if_changed)
                except Exception as error:
                    sync_log("sync-calendar-error", calendarId=calendar.get("id"), error=str(error)[:200], ifChanged=if_changed)
                    mode, synced, remote_uids = (("unchanged", [], []) if if_changed else ("eds", [], []))
            calendar_modes[calendar["id"]] = mode
            remote_touches[calendar["id"]] = remote_uids
            cached_for_cal = [event for event in (cache.get("events") or []) if (event or {}).get("calendarId") == calendar["id"]]
            sync_log("sync-calendar", calendarId=calendar["id"], name=calendar.get("name"), host=calendar.get("host"), mode=mode, ifChanged=if_changed, cached=len(cached_for_cal))
            if mode == "unchanged":
                calendar["readonly"] = False if is_omarchy_source_uid(source.get_uid()) else calendar.get("readonly")
                events.extend(cached_for_cal)
                continue
            if mode == "updated":
                calendar["readonly"] = False if is_omarchy_source_uid(source.get_uid()) else calendar.get("readonly")
                events.extend(synced)
                continue
            client = modules.ECal.Client.connect_sync(source, modules.ECal.ClientSourceType.EVENTS, 10, None)
            calendar["readonly"] = False if is_omarchy_source_uid(source.get_uid()) else bool(client.is_readonly())
            host = str(calendar.get("host") or "")
            if not is_forwardemail_host(host) and hasattr(client, "check_refresh_supported") and client.check_refresh_supported():
                try:
                    client.refresh_sync(None)
                    sync_log("sync-eds-refresh", calendarId=calendar["id"])
                except Exception as error:
                    sync_log("sync-eds-refresh-failed", calendarId=calendar["id"], error=str(error)[:200])
            before = len(events)
            eds_pull_calendar_events(client, calendar, window_start, window_end, modules, events)
            sync_log("sync-eds-pull", calendarId=calendar["id"], pulled=len(events) - before)
        except Exception as error:
            calendar["readonly"] = False if is_omarchy_source_uid(source.get_uid()) else True
            if not listed:
                calendars.append(calendar)
            errors.append({"calendarId": calendar["id"], "code": "calendar-error", "message": str(error)})

    if len(events) > MAX_EVENTS:
        del events[MAX_EVENTS:]
    payload = {
        "ok": True,
        "provider": "evolution-data-server",
        "calendars": calendars,
        "events": events,
        "cached": False,
        "range": {"start": iso(window_start), "end": iso(window_end)},
        "syncState": sync_state_map(cache),
    }
    if errors:
        payload["warnings"] = errors
    if include_events:
        payload["_modes"] = calendar_modes
        payload["_remote"] = remote_touches
        payload["_removed"] = cache.get("_removed") if isinstance(cache.get("_removed"), dict) else {}
        payload = adopt_newer_cache_events(payload, start_rev, calendar_modes, remote_touches, start_state, payload["_removed"])
        write_cache(payload)
    return payload


def parse_instant(value: str) -> datetime:
    if value.endswith("Z"):
        value = value[:-1] + "+00:00"
    parsed = datetime.fromisoformat(value)
    if parsed.tzinfo is None:
        parsed = parsed.replace(tzinfo=UTC)
    return parsed.astimezone(UTC)


def parse_event_instant(value: str) -> datetime | None:
    text = str(value or "").strip()
    if not text:
        return None
    try:
        if len(text) >= 10 and text[4] == "-" and "T" not in text[:11]:
            return datetime.fromisoformat(text[:10] + "T00:00:00+00:00").astimezone(UTC)
        return parse_instant(text)
    except Exception:
        return None


def sync_log(message: str, **fields) -> None:
    try:
        path = cache_dir() / "sync.log"
        line = {"at": iso(datetime.now(UTC)), "message": message}
        line.update(fields)
        with path.open("a", encoding="utf-8") as handle:
            handle.write(json.dumps(line, separators=(",", ":")) + "\n")
    except Exception:
        return


def cache_dir() -> Path:
    override = os.environ.get("OMARCHY_CALENDAR_CACHE")
    path = Path(override) if override else Path.home() / ".local/share/omarchy-calendar"
    path.mkdir(parents=True, exist_ok=True)
    return path


def cache_file() -> Path:
    return cache_dir() / "cache.json"


def shell_config_path() -> Path:
    override = os.environ.get("OMARCHY_SHELL_CONFIG")
    return Path(override) if override else Path.home() / ".config/omarchy/shell.json"


def ensure_center_anchor(plugin_id: str) -> dict:
    plugin_id = str(plugin_id or "").strip()
    path = shell_config_path()
    if not plugin_id or not path.is_file():
        return {"ok": True, "changed": False}
    try:
        data = json.loads(path.read_text(encoding="utf-8"))
    except Exception:
        return {"ok": True, "changed": False}
    bar = data.get("bar") if isinstance(data, dict) else None
    if not isinstance(bar, dict):
        return {"ok": True, "changed": False}
    if str(bar.get("centerAnchor") or "") != "omarchy.clock":
        return {"ok": True, "changed": False, "centerAnchor": str(bar.get("centerAnchor") or "")}
    center = ((bar.get("layout") or {}).get("center") or [])
    ids = [str(entry.get("id") or "") if isinstance(entry, dict) else str(entry) for entry in center]
    if plugin_id not in ids:
        return {"ok": True, "changed": False, "centerAnchor": "omarchy.clock"}
    text = path.read_text(encoding="utf-8")
    updated = text.replace('"centerAnchor": "omarchy.clock"', f'"centerAnchor": "{plugin_id}"', 1)
    if updated == text:
        bar["centerAnchor"] = plugin_id
        tmp = path.with_suffix(".json.tmp")
        tmp.write_text(json.dumps(data, indent=2) + "\n", encoding="utf-8")
        tmp.replace(path)
    else:
        tmp = path.with_suffix(".json.tmp")
        tmp.write_text(updated, encoding="utf-8")
        tmp.replace(path)
    return {"ok": True, "changed": True, "centerAnchor": plugin_id}


def reminders_file() -> Path:
    return cache_dir() / "reminders.json"


def read_reminders() -> dict:
    text = read_limited_text(reminders_file(), MAX_REMINDER_BYTES)
    try:
        data = json.loads(text) if text is not None else {}
    except Exception:
        data = {}
    if not isinstance(data, dict):
        data = {}
    minutes = data.get("minutes")
    try:
        minutes = int(minutes)
    except Exception:
        minutes = 10
    if minutes not in (0, 5, 10, 15, 30):
        minutes = 10
    fired = data.get("fired") or []
    if not isinstance(fired, list):
        fired = []
    return {"ok": True, "minutes": minutes, "fired": [str(item) for item in fired if item][:MAX_FIRED]}


def write_reminders(payload: dict) -> dict:
    current = read_reminders()
    minutes = payload.get("minutes", current["minutes"])
    try:
        minutes = int(minutes)
    except Exception:
        minutes = current["minutes"]
    if minutes not in (0, 5, 10, 15, 30):
        minutes = current["minutes"]
    fired = payload.get("fired")
    if not isinstance(fired, list):
        fired = current["fired"]
    data = {"minutes": minutes, "fired": [str(item) for item in fired if item][:MAX_FIRED]}
    path = reminders_file()
    tmp = path.with_suffix(".json.tmp")
    raw = json.dumps(data, separators=(",", ":"))
    if len(raw.encode("utf-8")) > MAX_REMINDER_BYTES:
        data["fired"] = data["fired"][: max(0, len(data["fired"]) // 2)]
        raw = json.dumps(data, separators=(",", ":"))
        while len(raw.encode("utf-8")) > MAX_REMINDER_BYTES and data["fired"]:
            data["fired"] = data["fired"][: max(0, len(data["fired"]) // 2)]
            raw = json.dumps(data, separators=(",", ":"))
    if len(raw.encode("utf-8")) > MAX_REMINDER_BYTES:
        return {"ok": False, "minutes": minutes, "fired": current["fired"], "error": {"code": "reminders-too-large", "message": "Reminder state was too large."}}
    tmp.write_text(raw, encoding="utf-8")
    tmp.replace(path)
    return {"ok": True, "minutes": minutes, "fired": data["fired"]}


def cache_rev(cache: dict | None) -> int:
    try:
        return int((cache or {}).get("rev") or 0)
    except (TypeError, ValueError):
        return 0


def local_touch_map(cache: dict | None) -> dict:
    raw = (cache or {}).get("localTouches") if isinstance((cache or {}).get("localTouches"), dict) else {}
    mapped: dict[str, dict[str, str]] = {}
    for calendar_id, value in raw.items():
        cal_id = str(calendar_id or "")
        if not cal_id:
            continue
        if isinstance(value, dict):
            mapped[cal_id] = {str(uid): str(op or "delete") for uid, op in value.items() if uid}
        elif isinstance(value, list):
            mapped[cal_id] = {str(uid): "delete" for uid in value if uid}
    return mapped


def note_local_touch(cache: dict, calendar_id: str, uid: str, op: str = "delete") -> None:
    cal_id = str(calendar_id or "")
    event_uid = str(uid or "")
    if not cal_id or not event_uid:
        return
    touches = local_touch_map(cache)
    current = dict(touches.get(cal_id) or {})
    current[event_uid] = str(op or "delete")
    touches[cal_id] = current
    cache["localTouches"] = touches


def note_event_touch(cache: dict, event: dict | None, op: str = "delete") -> None:
    if not event:
        return
    calendar_id = str(event.get("calendarId") or "")
    note_local_touch(cache, calendar_id, str(event.get("uid") or ""), op)
    note_local_touch(cache, calendar_id, str(event.get("hrefUid") or ""), op)


def deleted_touch_keys(cache: dict | None, calendar_id: str) -> list:
    ops = local_touch_map(cache).get(str(calendar_id or ""), {})
    return [uid for uid, op in ops.items() if op == "delete"]


def touch_keys(touches: dict, calendar_id: str) -> set[str]:
    return {str(uid) for uid in (touches.get(calendar_id) or {}) if uid}


def prune_local_touches(touches: dict, removed_by_cal: dict, listed_by_cal: dict | None = None) -> dict:
    remaining: dict[str, dict[str, str]] = {}
    for calendar_id, ops in (touches or {}).items():
        removed = {str(uid) for uid in (removed_by_cal.get(calendar_id) or []) if uid}
        listed = {str(uid) for uid in (listed_by_cal or {}).get(calendar_id) or [] if uid}
        kept = {}
        for uid, op in (ops or {}).items():
            if op == "delete" and uid in removed:
                continue
            if op == "create" and uid in listed:
                continue
            kept[str(uid)] = str(op)
        if kept:
            remaining[str(calendar_id)] = kept
    return remaining


def events_by_calendar(events: list) -> dict:
    grouped: dict[str, list] = {}
    for event in events or []:
        cal_id = str((event or {}).get("calendarId") or "")
        grouped.setdefault(cal_id, []).append(event)
    return grouped


def merge_snapshot_with_local(snapshot_events: list, disk: dict | None, modes: dict, remote_uids: dict, sync_state: dict, start_state: dict) -> list:
    disk = disk if isinstance(disk, dict) else {}
    touches = local_touch_map(disk)
    disk_by = events_by_calendar(disk.get("events") or [])
    snap_by = events_by_calendar(snapshot_events)
    merged = []
    for cal_id in set(disk_by) | set(snap_by) | set(modes) | set(touches):
        local_uids = touch_keys(touches, cal_id)
        deleted = {uid for uid, op in (touches.get(cal_id) or {}).items() if op == "delete"}
        mode = str(modes.get(cal_id) or "unchanged")
        disk_events = disk_by.get(cal_id) or []
        snap_events = snap_by.get(cal_id) or []
        if mode == "unchanged":
            merged.extend(disk_events or snap_events)
            continue
        remote_changed = {str(uid) for uid in (remote_uids.get(cal_id) or []) if uid}
        if deleted & remote_changed:
            previous = start_state.get(cal_id)
            if isinstance(previous, dict):
                sync_state[cal_id] = dict(previous)
            else:
                sync_state.pop(cal_id, None)
            sync_log("snapshot-hold-token", calendarId=cal_id, uids=sorted(deleted & remote_changed))
        merged.extend([event for event in snap_events if event_sync_keys(event).isdisjoint(local_uids)])
        merged.extend([event for event in disk_events if not event_sync_keys(event).isdisjoint(local_uids)])
    return merged


def adopt_newer_cache_events(payload: dict, start_rev: int, modes: dict | None = None, remote_uids: dict | None = None, start_state: dict | None = None, removed_uids: dict | None = None) -> dict:
    disk = read_cache()
    next_payload = dict(payload)
    touches = local_touch_map(disk)
    if cache_rev(disk) > start_rev or touches:
        state = next_payload.get("syncState") if isinstance(next_payload.get("syncState"), dict) else {}
        next_payload["events"] = merge_snapshot_with_local(next_payload.get("events") or [], disk, modes or {}, remote_uids or {}, state, start_state or {})
        next_payload["syncState"] = state
        next_payload["rev"] = max(start_rev, cache_rev(disk))
        present = {}
        for event in next_payload["events"]:
            cal_id = str((event or {}).get("calendarId") or "")
            present.setdefault(cal_id, set()).update(event_sync_keys(event))
        next_payload["localTouches"] = prune_local_touches(touches, removed_uids or {}, present)
        sync_log("snapshot-keep-local", startRev=start_rev, diskRev=cache_rev(disk), events=len(next_payload["events"]), touches=next_payload["localTouches"])
    else:
        next_payload["rev"] = start_rev
        next_payload["localTouches"] = touches
    return next_payload


def write_cache(payload: dict, bump: bool = False) -> None:
    path = cache_file()
    tmp = path.with_suffix(".json.tmp")
    disk = None if bump else read_cache()
    if disk is not None and cache_rev(disk) > cache_rev(payload):
        payload = dict(payload)
        state = payload.get("syncState") if isinstance(payload.get("syncState"), dict) else {}
        payload["events"] = merge_snapshot_with_local(
            payload.get("events") or [],
            disk,
            payload.get("_modes") if isinstance(payload.get("_modes"), dict) else {},
            payload.get("_remote") if isinstance(payload.get("_remote"), dict) else {},
            state,
            {},
        )
        payload["syncState"] = state
        payload["localTouches"] = prune_local_touches(local_touch_map(disk), payload.get("_removed") if isinstance(payload.get("_removed"), dict) else {}, None)
        payload["rev"] = cache_rev(disk)
        sync_log("cache-keep-newer", diskRev=cache_rev(disk), payloadRev=cache_rev(payload))
    rev = cache_rev(payload)
    if bump:
        rev = max(rev, cache_rev(read_cache())) + 1
    data = {
        "ok": True,
        "provider": payload.get("provider") or "evolution-data-server",
        "calendars": bound_items(payload.get("calendars"), MAX_CALENDARS),
        "events": bound_items(payload.get("events"), MAX_EVENTS),
        "cachedAt": iso(datetime.now(UTC)),
        "range": payload.get("range") or {},
        "syncState": payload.get("syncState") if isinstance(payload.get("syncState"), dict) else {},
        "rev": rev,
        "localTouches": local_touch_map(payload),
    }
    raw = json.dumps(data, separators=(",", ":"))
    while len(raw.encode("utf-8")) > MAX_CACHE_BYTES and data["events"]:
        data["events"] = data["events"][: max(0, len(data["events"]) // 2)]
        raw = json.dumps(data, separators=(",", ":"))
    if len(raw.encode("utf-8")) > MAX_CACHE_BYTES:
        return
    tmp.write_text(raw, encoding="utf-8")
    tmp.replace(path)


def read_cache() -> dict | None:
    path = cache_file()
    text = read_limited_text(path, MAX_CACHE_BYTES)
    if text is None:
        return None
    try:
        data = json.loads(text)
    except Exception:
        return None
    if not isinstance(data, dict) or data.get("ok") is not True:
        return None
    data["calendars"] = bound_items(data.get("calendars"), MAX_CALENDARS)
    data["events"] = bound_items(data.get("events"), MAX_EVENTS)
    return data


def filter_events(events, start: datetime, end: datetime) -> list:
    result = []
    for event in events or []:
        event_start = parse_event_instant((event or {}).get("start"))
        if event_start is None:
            continue
        event_end = parse_event_instant((event or {}).get("end")) or event_start
        if event_start < end and event_end >= start:
            result.append(event)
    return result


def cached_snapshot(start: datetime, end: datetime, provider: str) -> dict:
    cache = read_cache()
    if not cache:
        return {
            "ok": False,
            "provider": provider,
            "calendars": [],
            "events": [],
            "cached": True,
            "error": {"code": "no-cache", "message": "No local calendar cache yet."},
        }
    return {
        "ok": True,
        "provider": cache.get("provider") or provider,
        "calendars": bound_items(cache.get("calendars"), MAX_CALENDARS),
        "events": bound_items(cache.get("events"), MAX_EVENTS),
        "cached": True,
        "cachedAt": cache.get("cachedAt") or "",
        "range": {"start": iso(start), "end": iso(end)},
    }


def merge_cache_calendars(added: list) -> None:
    cache = read_cache() or {"ok": True, "provider": "evolution-data-server", "calendars": [], "events": []}
    existing = {str(item.get("id") or ""): item for item in (cache.get("calendars") or []) if item}
    for calendar in added or []:
        if calendar and calendar.get("id"):
            existing[str(calendar["id"])] = calendar
    cache["calendars"] = list(existing.values())
    write_cache(cache, bump=True)


def merge_cache_event(event: dict, series: bool = False) -> None:
    if not event or not event.get("id"):
        return
    cache = read_cache() or {"ok": True, "provider": "evolution-data-server", "calendars": [], "events": []}
    note_event_touch(cache, event, "create")
    if series:
        updated = []
        found = False
        for existing in cache.get("events") or []:
            if existing.get("uid") == event.get("uid") and existing.get("calendarId") == event.get("calendarId"):
                found = True
                next_event = dict(existing)
                for key in ("title", "location", "description", "calendarName", "calendarColor"):
                    if key in event:
                        next_event[key] = event[key]
                if existing.get("id") == event.get("id") or not existing.get("rid"):
                    for key in ("start", "end", "allDay", "id"):
                        if key in event:
                            next_event[key] = event[key]
                updated.append(next_event)
            else:
                updated.append(existing)
        if not found:
            updated.append(event)
        cache["events"] = updated
    else:
        events = [existing for existing in (cache.get("events") or []) if existing.get("id") != event.get("id")]
        events.append(event)
        cache["events"] = events
    write_cache(cache, bump=True)


def apply_calendar_overrides_to_cache(updates: list) -> None:
    cache = read_cache()
    if not cache:
        return
    by_id = {str(item.get("id") or ""): item for item in updates if item and item.get("id")}
    if not by_id:
        return
    for calendar in cache.get("calendars") or []:
        item = by_id.get(str(calendar.get("id") or ""))
        if not item:
            continue
        name = str(item.get("name") or "").strip()
        color = str(item.get("color") or "").strip()
        if name:
            calendar["name"] = name
        if color:
            calendar["color"] = color
    for event in cache.get("events") or []:
        item = by_id.get(str(event.get("calendarId") or ""))
        if not item:
            continue
        name = str(item.get("name") or "").strip()
        color = str(item.get("color") or "").strip()
        if name:
            event["calendarName"] = name
        if color:
            event["calendarColor"] = color
    write_cache(cache)


def eds_update_calendars(items: list) -> dict:
    modules = load_eds_modules()
    registry = modules.EDataServer.SourceRegistry.new_sync(None)
    updated = []
    for item in items or []:
        calendar_id = str((item or {}).get("id") or "").strip()
        if not calendar_id or not is_omarchy_source_uid(calendar_id):
            continue
        source = registry.ref_source(calendar_id)
        if source is None:
            continue
        name = str(item.get("name") or "").strip()
        color = str(item.get("color") or "").strip()
        if name:
            source.set_display_name(name)
        if color.startswith("#") and source.has_extension(modules.EDataServer.SOURCE_EXTENSION_CALENDAR):
            source.get_extension(modules.EDataServer.SOURCE_EXTENSION_CALENDAR).set_color(color)
            if source.has_extension(modules.EDataServer.SOURCE_EXTENSION_WEBDAV_BACKEND):
                source.get_extension(modules.EDataServer.SOURCE_EXTENSION_WEBDAV_BACKEND).set_color(color)
        if not registry.commit_source_sync(source, None):
            raise ValueError(f"Failed to update calendar: {source.get_display_name()}")
        updated.append(source_calendar(source, registry, modules))
    apply_calendar_overrides_to_cache(items or [])
    return {"ok": True, "provider": "evolution-data-server", "calendars": updated}


def remove_calendar_from_cache(calendar_id: str) -> None:
    cache = read_cache()
    if not cache or not calendar_id:
        return
    cache["calendars"] = [calendar for calendar in (cache.get("calendars") or []) if calendar.get("id") != calendar_id]
    cache["events"] = [event for event in (cache.get("events") or []) if event.get("calendarId") != calendar_id]
    write_cache(cache)


def eds_create_local_calendar(display_name: str) -> dict:
    name = str(display_name or "").strip() or "Calendar"
    modules = load_eds_modules()
    registry = modules.EDataServer.SourceRegistry.new_sync(None)
    source = modules.EDataServer.Source.new_with_uid(f"omarchy-calendar-local-{uuid4()}", None)
    if registry.ref_source("local-stub"):
        source.set_parent("local-stub")
    source.set_display_name(name)
    source.set_enabled(True)
    calendar = source.get_extension(modules.EDataServer.SOURCE_EXTENSION_CALENDAR)
    calendar.set_backend_name("local")
    if hasattr(calendar, "set_selected"):
        calendar.set_selected(True)
    source = commit_new_source(registry, source)
    if source is None:
        raise ValueError("Failed to create a local calendar.")
    created = source_calendar(source, registry, modules)
    created["readonly"] = False
    cache = read_cache()
    if cache:
        calendars = [item for item in (cache.get("calendars") or []) if item.get("id") != created["id"]]
        calendars.append(created)
        cache["calendars"] = calendars
        write_cache(cache)
    return {"ok": True, "provider": "evolution-data-server", "calendar": created}


def eds_remove_calendar(calendar_id: str) -> dict:
    calendar_id = str(calendar_id or "").strip()
    if not is_omarchy_source_uid(calendar_id):
        raise ValueError("Calendar not found.")
    modules = load_eds_modules()
    registry = modules.EDataServer.SourceRegistry.new_sync(None)
    source = registry.ref_source(calendar_id)
    if source is None:
        raise ValueError("Calendar not found.")
    removed = False
    if hasattr(source, "remove_sync"):
        try:
            source.remove_sync(None)
            removed = True
        except Exception:
            removed = False
    if not removed:
        source.set_enabled(False)
        if not registry.commit_source_sync(source, None):
            raise ValueError("Unable to remove this calendar source.")
    remove_calendar_from_cache(calendar_id)
    return {"ok": True, "provider": "evolution-data-server", "calendarId": calendar_id}


def remove_cache_event(event_id: str) -> None:
    cache = read_cache()
    if not cache or not event_id:
        return
    remaining = []
    for existing in cache.get("events") or []:
        if existing.get("id") == event_id:
            note_event_touch(cache, existing, "delete")
            continue
        remaining.append(existing)
    cache["events"] = remaining
    write_cache(cache, bump=True)


def main(argv: list[str]) -> int:
    parser = argparse.ArgumentParser(description="Return normalized calendar data as JSON")
    parser.add_argument("operation", choices=["snapshot", "list-calendars", "create-event", "update-event", "delete-event", "setup-caldav", "create-local-calendar", "update-calendars", "remove-calendar", "reminders-state", "reminders-save", "ensure-center-anchor", "eds-status"])
    parser.add_argument("--provider", default=os.environ.get("OMARCHY_CALENDAR_PROVIDER", "mock"))
    parser.add_argument("--from", dest="start", default=iso(datetime.now(UTC).replace(hour=0, minute=0, second=0, microsecond=0)))
    parser.add_argument("--to", dest="end", default=iso(datetime.now(UTC).replace(hour=0, minute=0, second=0, microsecond=0) + timedelta(days=31)))
    parser.add_argument("--calendar-id", default="")
    parser.add_argument("--to-calendar-id", default="")
    parser.add_argument("--title", default="")
    parser.add_argument("--location", default="")
    parser.add_argument("--description", default="")
    parser.add_argument("--all-day", action="store_true")
    parser.add_argument("--uid", default="")
    parser.add_argument("--rid", default="")
    parser.add_argument("--scope", default="")
    parser.add_argument("--rrule", default="")
    parser.add_argument("--meeting-url", default="")
    parser.add_argument("--meeting-kind", default="none")
    parser.add_argument("--from-cache", action="store_true")
    parser.add_argument("--if-changed", action="store_true")
    args = parser.parse_args(argv)

    start = parse_instant(args.start)
    end = parse_instant(args.end)

    try:
        if args.from_cache and args.operation in ("snapshot", "list-calendars"):
            payload = cached_snapshot(start, end, args.provider)
            if args.operation == "list-calendars":
                payload = {key: value for key, value in payload.items() if key != "events"}
            return emit_json(payload)
        if args.operation == "eds-status":
            return emit_json(eds_status())
        if args.operation == "ensure-center-anchor":
            return emit_json(ensure_center_anchor(args.title or "sirwizardlizard.calendar"))
        if args.operation == "reminders-state":
            return emit_json(read_reminders())
        if args.operation == "reminders-save":
            raw = read_stdin_limited(MAX_REMINDER_BYTES)
            return emit_json(write_reminders(json.loads(raw or "{}")))
        if args.operation == "create-event":
            location = apply_meeting(args.meeting_kind, args.meeting_url, args.location)
            if args.provider not in ("eds", "evolution-data-server"):
                raise ValueError("create-event currently requires the evolution-data-server provider.")
            return emit_json(eds_create_event(args.calendar_id, args.title, start, end, args.all_day, location, args.description, normalize_rrule(args.rrule)))
        if args.operation == "update-event":
            location = apply_meeting(args.meeting_kind, args.meeting_url, args.location)
            dest = args.to_calendar_id or args.calendar_id
            if args.provider not in ("eds", "evolution-data-server"):
                raise ValueError("update-event currently requires the evolution-data-server provider.")
            return emit_json(eds_update_event(args.calendar_id, args.uid, args.rid, args.title, start, end, args.all_day, location, args.description, args.scope, dest))
        if args.operation == "delete-event":
            if not args.uid:
                raise ValueError("delete-event requires --uid.")
            if args.provider not in ("eds", "evolution-data-server"):
                raise ValueError("delete-event currently requires the evolution-data-server provider.")
            return emit_json(eds_delete_event(args.calendar_id, args.uid, args.rid if args.scope != "all" else ""))
        if args.operation == "setup-caldav":
            if args.provider not in ("eds", "evolution-data-server"):
                raise ValueError("setup-caldav currently requires the evolution-data-server provider.")
            raw = read_stdin_limited(MAX_REMINDER_BYTES)
            return emit_json(eds_setup_caldav(json.loads(raw or "{}")))
        if args.operation == "create-local-calendar":
            if args.provider not in ("eds", "evolution-data-server"):
                raise ValueError("create-local-calendar currently requires the evolution-data-server provider.")
            return emit_json(eds_create_local_calendar(args.title))
        if args.operation == "remove-calendar":
            if not args.calendar_id:
                raise ValueError("remove-calendar requires --calendar-id.")
            if args.provider not in ("eds", "evolution-data-server"):
                raise ValueError("remove-calendar currently requires the evolution-data-server provider.")
            return emit_json(eds_remove_calendar(args.calendar_id))
        if args.operation == "update-calendars":
            raw = read_stdin_limited(MAX_REMINDER_BYTES)
            items = bound_items((json.loads(raw or "{}") or {}).get("calendars") or [], MAX_CALENDARS)
            if args.provider in ("eds", "evolution-data-server"):
                payload = eds_update_calendars(items)
            else:
                apply_calendar_overrides_to_cache(items)
                payload = {"ok": True, "provider": args.provider, "calendars": items}
            return emit_json(payload)
    except Exception as error:
        return emit_json({"ok": False, "provider": args.provider, "error": {"code": "operation-failed", "message": str(error)}})

    if args.provider == "mock":
        payload = mock_snapshot(start, end)
        write_cache(payload)
    elif args.provider in ("eds", "evolution-data-server"):
        payload = eds_snapshot(start, end, args.operation != "list-calendars", args.if_changed)
    else:
        payload = {
            "ok": False,
            "provider": args.provider,
            "calendars": [],
            "events": [],
            "error": {"code": "unknown-provider", "message": f"Unknown provider: {args.provider}"},
        }

    if args.operation == "list-calendars":
        payload = {key: value for key, value in payload.items() if key != "events"}

    return emit_json(payload)


if __name__ == "__main__":
    raise SystemExit(main(sys.argv[1:]))
