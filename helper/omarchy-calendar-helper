MAX_CACHE_BYTES = 8 * 1024 * 1024
MAX_REMINDER_BYTES = 256 * 1024
MAX_STDOUT_BYTES = 8 * 1024 * 1024
MAX_ERROR_BYTES = 64 * 1024
MAX_CALDAV_RESPONSE_BYTES = 32 * 1024 * 1024
MAX_CALDAV_TRANSACTION_BYTES = 64 * 1024 * 1024
CALDAV_READ_CHUNK = 64 * 1024
MAX_EVENTS = 8000
MAX_DAV_HREF_CHARS = 8192
MAX_DAV_TOKEN_BYTES = 16 * 1024
MAX_DAV_XML_ELEMENTS = MAX_EVENTS * 24 + 2048
CALDAV_SYNC_PAGE_SIZE = 64
CALDAV_MULTIGET_BATCH_SIZE = 64
MAX_CALDAV_SYNC_PAGES = 128
MAX_CALDAV_REQUESTS = MAX_EVENTS + 2 * MAX_CALDAV_SYNC_PAGES
CALDAV_SYNC_SECONDS = 45.0
MAX_CALENDARS = 200
MAX_FIRED = 2000


class CaldavResponseTooLarge(ValueError):
    def __init__(self) -> None:
        super().__init__("Calendar server response was too large.")


class CaldavTransactionTooLarge(ValueError):
    def __init__(self) -> None:
        super().__init__("Calendar synchronization responses were too large.")


class CaldavUnsafeRedirect(ValueError):
    pass


class CaldavRedirectHandler(urllib.request.HTTPRedirectHandler):
    max_redirections = 5

    def __init__(self, allowed, password_manager=None, username: str = "", password: str = ""):
        super().__init__()
        self.allowed = allowed
        self.password_manager = password_manager
        self.username = username
        self.password = password

    def redirect_request(self, request, fp, code, message, headers, new_url):
        target = urljoin(request.full_url, new_url)
        if not self.allowed(request.full_url, target):
            raise CaldavUnsafeRedirect("Calendar server redirected outside the allowed location.")
        if self.password_manager is not None:
            self.password_manager.add_password(None, target, self.username, self.password)
        method = request.get_method()
        data = request.data
        if code == 303 and method != "HEAD":
            method = "GET"
            data = None
        copied_headers = {
            key: value
            for key, value in request.header_items()
            if key.lower() not in ("authorization", "proxy-authorization", "host", "content-length")
            and not (data is None and key.lower() == "content-type")
        }
        return urllib.request.Request(target, data=data, headers=copied_headers, origin_req_host=request.origin_req_host, unverifiable=True, method=method)


def http_content_length(headers) -> int | None:
    if headers is None:
        return None
    getter = getattr(headers, "get", None)
    raw = getter("Content-Length") if callable(getter) else None
    if raw is None or raw == "":
        return None
    try:
        value = int(str(raw).strip())
    except (TypeError, ValueError):
        return None
    if value < 0:
        return None
    return value


def close_http_error(error) -> None:
    closer = getattr(error, "close", None)
    if callable(closer):
        try:
            closer()
        except Exception:
            return


def set_http_read_timeout(response, timeout: float) -> None:
    try:
        response.fp.raw._sock.settimeout(max(0.001, timeout))
    except (AttributeError, OSError):
        pass


@contextmanager
def enforce_http_deadline(timeout: float):
    if threading.current_thread() is not threading.main_thread() or not hasattr(signal, "setitimer"):
        yield
        return
    previous_handler = signal.getsignal(signal.SIGALRM)
    previous_delay, _previous_interval = signal.getitimer(signal.ITIMER_REAL)
    if previous_delay > 0:
        raise TimeoutError("Cannot start a calendar request while another process deadline is active.")

    def timeout_handler(_signum, _frame):
        raise TimeoutError("Calendar server timed out.")

    signal.signal(signal.SIGALRM, timeout_handler)
    signal.setitimer(signal.ITIMER_REAL, max(0.001, timeout))
    try:
        yield
    finally:
        signal.setitimer(signal.ITIMER_REAL, 0)
        signal.signal(signal.SIGALRM, previous_handler)


def read_limited_http_body(response, max_bytes: int | None = None, deadline: float | None = None) -> bytes:
    if max_bytes is None:
        max_bytes = MAX_CALDAV_RESPONSE_BYTES
    declared = http_content_length(getattr(response, "headers", None))
    if declared is not None and declared > max_bytes:
        raise CaldavResponseTooLarge()
    chunks: list[bytes] = []
    total = 0
    while True:
        if deadline is not None:
            remaining = deadline - time.monotonic()
            if remaining <= 0:
                raise TimeoutError("Calendar server timed out.")
            set_http_read_timeout(response, remaining)
        reader = getattr(response, "read1", None)
        if not callable(reader):
            reader = response.read
        chunk = reader(min(CALDAV_READ_CHUNK, max_bytes - total + 1))
        if not chunk:
            break
        total += len(chunk)
        if total > max_bytes:
            raise CaldavResponseTooLarge()
        chunks.append(chunk)
    return b"".join(chunks)


def read_limited_text(path: Path, max_bytes: int) -> str | None:
    try:
        if not path.is_file() or path.stat().st_size > max_bytes:
            return None
        with path.open("rb") as handle:
            data = handle.read(max_bytes + 1)
    except OSError:
        return None
    if len(data) > max_bytes:
        return None
    try:
        return data.decode("utf-8")
    except UnicodeDecodeError:
        return None


def parse_limited_xml(xml_bytes: bytes):
    if len(xml_bytes) > MAX_CALDAV_RESPONSE_BYTES:
        raise ET.ParseError("DAV XML response was too large.")
    validator = expat.ParserCreate()
    depth = 0
    elements = 0

    def reject_declaration(*_args):
        raise ET.ParseError("DAV XML response contained a forbidden declaration.")

    def start_element(_name, _attributes):
        nonlocal depth, elements
        depth += 1
        elements += 1
        if depth > 64 or elements > MAX_DAV_XML_ELEMENTS:
            raise ET.ParseError("DAV XML response was too complex.")

    def end_element(_name):
        nonlocal depth
        depth -= 1

    validator.StartDoctypeDeclHandler = reject_declaration
    validator.EntityDeclHandler = reject_declaration
    validator.ExternalEntityRefHandler = reject_declaration
    validator.StartElementHandler = start_element
    validator.EndElementHandler = end_element
    try:
        for offset in range(0, len(xml_bytes), CALDAV_READ_CHUNK):
            validator.Parse(xml_bytes[offset : offset + CALDAV_READ_CHUNK], False)
        validator.Parse(b"", True)
    except expat.ExpatError as error:
        raise ET.ParseError(str(error)) from error
    except ET.ParseError:
        raise
    if elements == 0 or depth != 0:
        raise ET.ParseError("DAV XML response was empty or incomplete.")
    return ET.fromstring(xml_bytes)


def read_stdin_limited(max_bytes: int) -> str:
    data = sys.stdin.readline(max_bytes + 1)
    if len(data.encode("utf-8")) > max_bytes:
        raise ValueError("Request was too large.")
    return data


def bound_items(items, limit: int) -> list:
    if not isinstance(items, list):
        return []
    return items[:limit]


def bound_payload(payload: dict) -> dict:
    if not isinstance(payload, dict):
        return {
            "ok": False,
            "calendars": [],
            "events": [],
            "error": {"code": "invalid-payload", "message": "Invalid calendar payload."},
        }
    bounded = dict(payload)
    if "calendars" in bounded:
        bounded["calendars"] = bound_items(bounded.get("calendars"), MAX_CALENDARS)
    if "events" in bounded:
        bounded["events"] = bound_items(bounded.get("events"), MAX_EVENTS)
    if "fired" in bounded:
        bounded["fired"] = bound_items(bounded.get("fired"), MAX_FIRED)
    error = bounded.get("error")
    if isinstance(error, dict) and error.get("message"):
        message = str(error.get("message") or "")
        encoded = message.encode("utf-8")
        if len(encoded) > MAX_ERROR_BYTES:
            error = dict(error)
            error["message"] = encoded[:MAX_ERROR_BYTES].decode("utf-8", errors="ignore")
            bounded["error"] = error
    return bounded


def emit_json(payload: dict) -> int:
    bounded = bound_payload(payload)
    raw = json.dumps(bounded, separators=(",", ":"))
    if len(raw.encode("utf-8")) > MAX_STDOUT_BYTES:
        bounded = {
            "ok": False,
            "provider": bounded.get("provider") or "",
            "calendars": [],
            "events": [],
            "error": {"code": "response-too-large", "message": "Calendar response was too large."},
        }
        raw = json.dumps(bounded, separators=(",", ":"))
    sys.stdout.write(raw + "\n")
    return 0 if bounded.get("ok") else 1


def iso(value: datetime) -> str:
    return value.astimezone(UTC).replace(microsecond=0).isoformat().replace("+00:00", "Z")


def iso_to_rid(stamp: str, all_day: bool) -> str:
    text = str(stamp or "")
    if all_day and len(text) >= 10:
        return text[:10].replace("-", "")
    if "T" in text:
        date_part, time_part = text.split("T", 1)
        digits = "".join(ch for ch in time_part if ch.isdigit())
        suffix = "Z" if time_part.endswith("Z") else ""
        return date_part.replace("-", "") + "T" + (digits + "000000")[:6] + suffix
    return text.replace("-", "")


